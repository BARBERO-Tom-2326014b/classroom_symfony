{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}

    {# ===================== HEADER ===================== #}
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 fw-bold">
                Bienvenue{% if app.user %}, {{ app.user.prenom ?? app.user.userIdentifier }}{% endif %}
            </h1>
            <div class="text-muted">Votre plateforme de cours</div>
        </div>
    </div>

    {# ===================== VIDÉOS ===================== #}
    <div class="edl-section mb-4">
        <div class="edl-section-header d-flex justify-content-between align-items-center">
            <h2 class="edl-section-title mb-0">🎥 Mes vidéos</h2>

            <div class="edl-section-actions d-flex gap-2">
                {% if is_granted('ROLE_PROFESSEUR') %}
                    <button
                            class="edl-icon-btn"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#uploadVideoModal"
                            title="Ajouter une vidéo"
                    >+</button>
                {% endif %}
            </div>
        </div>

        <div class="edl-scroll" data-carousel>
            {% for video in videos %}
                {% set videoSrc = asset('uploads/videos/' ~ video.videoName) %}
                <div class="edl-card">
                    <div class="edl-card-media">
                        <video class="w-100 rounded" controls>
                            <source src="{{ videoSrc }}" type="video/mp4">
                        </video>
                    </div>
                    <div class="edl-card-body">
                        <div class="edl-card-title">{{ video.title }}</div>
                        <div class="edl-card-meta">
                            🧑‍🏫 {{ video.teacherFirstName }} {{ video.teacherLastName }}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="text-muted p-3">Aucune vidéo.</div>
            {% endfor %}
        </div>
    </div>

    {# ===================== DOCUMENTS ===================== #}
    <div class="edl-section">
        <div class="edl-section-header d-flex justify-content-between align-items-center">
            <h2 class="edl-section-title">📄 Documents de Cours</h2>

            {% if is_granted('ROLE_PROFESSEUR') %}
                <button
                        class="edl-icon-btn"
                        type="button"
                        data-bs-toggle="modal"
                        data-bs-target="#uploadDocumentModal"
                        title="Ajouter un document"
                >+</button>
            {% endif %}
        </div>

        <div class="edl-scroll" data-carousel>
            {% for doc in documents %}
                <div class="edl-card">
                    <div class="edl-card-body">
                        <div class="edl-card-title">{{ doc.title }}</div>
                        <div class="edl-card-meta">{{ doc.description ?? 'PDF' }}</div>

                        {% if doc.pdfName %}
                            {% set pdfSrc = asset('uploads/documents/' ~ doc.pdfName) %}
                            <div class="d-flex gap-2 mt-2">
                                <button
                                        class="btn edl-btn edl-btn-secondary flex-fill"
                                        data-bs-toggle="modal"
                                        data-bs-target="#pdfViewerModal"
                                        data-pdf-src="{{ pdfSrc }}"
                                        data-pdf-title="{{ doc.title|e('html_attr') }}"
                                >
                                    Voir
                                </button>

                                {% if is_granted('ROLE_PROFESSEUR') %}
                                    <button
                                            class="btn edl-btn edl-btn-primary js-generate-qcm"
                                            data-document-id="{{ doc.id }}"
                                    >
                                        🧠 Créer QCM
                                    </button>
                                {% endif %}
                            </div>
                        {% endif %}

                        {# ===== QCM GÉNÉRÉS ===== #}
                        {% if doc.qcms is defined and doc.qcms|length > 0 %}
                            <div class="mt-3">
                                <strong>📋 QCM générés</strong>
                                {% for qcm in doc.qcms %}
                                    <div class="border rounded p-2 mt-2 bg-light">
                                        <div class="fw-bold">{{ qcm.title }}</div>
                                        <div class="text-muted small">
                                            {{ qcm.questions|length }} questions
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            {% else %}
                <div class="text-muted p-3">Aucun document.</div>
            {% endfor %}
        </div>
    </div>

    {# ===================== MODAL PDF ===================== #}
    <div class="modal fade" id="pdfViewerModal" tabindex="-1">
        <div class="modal-dialog modal-xl modal-dialog-centered">
            <div class="modal-content">
                <div class="modal-header">
                    <h5 class="modal-title" id="pdfViewerTitle"></h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                </div>
                <div class="modal-body">
                    <iframe id="pdfViewerFrame" class="w-100" style="height:75vh"></iframe>
                </div>
            </div>
        </div>
    </div>

    {# ===================== JS QCM ===================== #}
    <script>
        document.addEventListener('DOMContentLoaded', () => {

            // PDF viewer
            const pdfModal = document.getElementById('pdfViewerModal');
            pdfModal?.addEventListener('show.bs.modal', e => {
                const btn = e.relatedTarget;
                document.getElementById('pdfViewerFrame').src = btn.dataset.pdfSrc;
                document.getElementById('pdfViewerTitle').textContent = btn.dataset.pdfTitle;
            });

            // Génération QCM
            document.querySelectorAll('.js-generate-qcm').forEach(btn => {
                btn.addEventListener('click', async () => {
                    btn.disabled = true;
                    btn.textContent = '⏳ Génération...';

                    const res = await fetch(`/api/documents/${btn.dataset.documentId}/generate-qcm`, {
                        method: 'POST'
                    });

                    if (!res.ok) {
                        alert('Erreur lors de la génération du QCM');
                        btn.disabled = false;
                        btn.textContent = '🧠 Créer QCM';
                        return;
                    }

                    location.reload();
                });
            });
        });
    </script>

{% endblock %}
