{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}

    {# ===================== HEADER ===================== #}
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 fw-bold">
                Bienvenue{% if app.user %}, {{ app.user.userIdentifier }}{% endif %}
            </h1>
            <div class="text-muted">Votre plateforme de cours</div>
        </div>
    </div>

    {# ===================== VIDÉOS ===================== #}
    <div class="edl-section mb-4">
        <div class="edl-section-header d-flex justify-content-between align-items-center">
            <h2 class="edl-section-title mb-0">🎥 Vidéos de Cours</h2>

            <div class="edl-section-actions d-flex gap-2">
                {% if is_granted('ROLE_PROFESSEUR') %}
                    <button
                            class="edl-icon-btn"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#uploadVideoModal"
                            title="Ajouter une vidéo"
                    >
                        +
                    </button>
                {% endif %}

                <button class="edl-icon-btn" type="button">←</button>
                <button class="edl-icon-btn" type="button">→</button>
            </div>
        </div>

        <div class="edl-scroll">
            {% for video in videos %}
                <div class="edl-card">

                    <div class="edl-card-media">
                        <video class="w-100 rounded" controls preload="metadata">
                            <source
                                    src="{{ asset('uploads/videos/' ~ video.videoName) }}"
                                    type="video/mp4"
                            >
                            Votre navigateur ne supporte pas la vidéo.
                        </video>
                    </div>

                    <div class="edl-card-body">
                        <div class="edl-card-title">{{ video.title }}</div>

                        <div class="edl-card-meta">
                            🧑‍🏫 {{ video.teacherFirstName }} {{ video.teacherLastName }}
                        </div>

                        <div class="edl-card-actions">
                            <a class="btn edl-btn edl-btn-primary flex-fill" href="#">
                                📚 Passer le QCM
                            </a>
                        </div>
                    </div>

                </div>
            {% else %}
                <div class="text-muted p-3">
                    Aucune vidéo pour le moment.
                </div>
            {% endfor %}
        </div>
    </div>

    {# ===================== DOCUMENTS ===================== #}
    <div class="edl-section">
        <div class="edl-section-header">
            <h2 class="edl-section-title">📄 Documents de Cours</h2>
        </div>

        <div class="edl-scroll">
            {% for doc in documents %}
                <div class="edl-card">
                    <div class="edl-card-body">
                        <div class="edl-card-title">{{ doc.title }}</div>
                    </div>
                </div>
            {% else %}
                <div class="text-muted p-3">
                    Aucun document pour le moment.
                </div>
            {% endfor %}
        </div>
    </div>

    {# ===================== MODAL UPLOAD VIDÉO ===================== #}
    {% if is_granted('ROLE_PROFESSEUR') %}
        <div class="modal fade" id="uploadVideoModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 rounded-4 shadow">

                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold">➕ Ajouter une vidéo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body pt-0">
                        {{ form_start(videoForm, {
                            action: path('video_new'),
                            attr: { enctype: 'multipart/form-data' }
                        }) }}

                        <div class="mb-3">
                            {{ form_label(videoForm.title) }}
                            {{ form_widget(videoForm.title, { attr: { class: 'form-control' } }) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(videoForm.description) }}
                            {{ form_widget(videoForm.description, { attr: { class: 'form-control' } }) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(videoForm.videoFile, 'Vidéo (MP4)') }}
                            {{ form_widget(videoForm.videoFile, { attr: { class: 'form-control' } }) }}
                        </div>

                        <button class="btn btn-primary w-100">
                            📤 Uploader la vidéo
                        </button>

                        {{ form_end(videoForm) }}
                    </div>

                </div>
            </div>
        </div>
    {% endif %}

    {# ===================== MODAL LOGIN ===================== #}
    {% if not app.user %}
        <div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 rounded-4 shadow">

                    <div class="modal-header border-0">
                        <h4 class="modal-title fw-bold">Connexion Étudiant</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body pt-0">
                        <form method="post" action="{{ path('app_login') }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input type="email" name="_username" class="form-control" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Mot de passe</label>
                                <input type="password" name="_password" class="form-control" required>
                            </div>

                            <button class="btn btn-primary w-100">
                                Se connecter
                            </button>
                        </form>

                        <div class="text-center mt-3">
                            <a href="{{ path('app_register') }}">Créer un compte</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    {% endif %}

{% endblock %}
