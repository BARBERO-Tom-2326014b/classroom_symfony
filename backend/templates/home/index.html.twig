{% extends 'base.html.twig' %}

{% block title %}Accueil{% endblock %}

{% block body %}

    {# ===================== HEADER ===================== #}
    <div class="d-flex align-items-center justify-content-between mb-4">
        <div>
            <h1 class="h3 mb-1 fw-bold">
                Bienvenue{% if app.user %}, {{ app.user.prenom ?? app.user.userIdentifier }}{% endif %}
            </h1>
            <div class="text-muted">Votre plateforme de cours</div>
        </div>

        {% if is_granted('ROLE_PROFESSEUR') %}
            <a class="btn btn-outline-secondary" href="{{ path('qcm_index') }}">Voir les QCM</a>
        {% endif %}
    </div>

    {# ===================== VIDÉOS ===================== #}
    <div class="edl-section mb-4">
        <div class="edl-section-header d-flex justify-content-between align-items-center">
            <h2 class="edl-section-title mb-0">🎥 Mes vidéos</h2>

            <div class="edl-section-actions d-flex gap-2">
                {% if is_granted('ROLE_PROFESSEUR') %}
                    <button
                            class="edl-icon-btn"
                            type="button"
                            data-bs-toggle="modal"
                            data-bs-target="#uploadVideoModal"
                            title="Ajouter une vidéo"
                    >
                        +
                    </button>
                {% endif %}

                <button class="edl-icon-btn" type="button" data-carousel-prev aria-label="Précédent">←</button>
                <button class="edl-icon-btn" type="button" data-carousel-next aria-label="Suivant">→</button>
            </div>
        </div>

        <div class="edl-scroll" data-carousel>
            {% for video in videos %}
                {% set videoSrc = asset('uploads/videos/' ~ video.videoName) %}

                <div class="edl-card">

                    <div class="edl-card-media">
                        <button
                            type="button"
                            class="w-100 p-0 border-0 bg-transparent"
                            data-bs-toggle="modal"
                            data-bs-target="#videoPlayerModal"
                            data-video-src="{{ videoSrc }}"
                            data-video-title="{{ video.title|e('html_attr') }}"
                            aria-label="Lire la vidéo {{ video.title }}"
                        >
                            <video class="w-100 rounded" preload="metadata" muted playsinline>
                                <source src="{{ videoSrc }}" type="video/mp4">
                                Votre navigateur ne supporte pas la vidéo.
                            </video>
                        </button>
                    </div>

                    <div class="edl-card-body">
                        <div class="edl-card-title">{{ video.title }}</div>

                        <div class="edl-card-meta">
                            🧑‍🏫 {{ video.teacherFirstName }} {{ video.teacherLastName }}
                        </div>

                        {# Bouton QCM retiré à la demande #}
                    </div>

                </div>
            {% else %}
                <div class="text-muted p-3">
                    Aucune vidéo pour le moment.
                </div>
            {% endfor %}
        </div>
    </div>

    {# ===================== DOCUMENTS ===================== #}
    <div class="edl-section">
        <div class="edl-section-header">
            <h2 class="edl-section-title">📄 Documents de Cours</h2>

            <div class="edl-section-actions d-flex gap-2">
                {% if is_granted('ROLE_PROFESSEUR') %}
                    {# Le sélecteur global peut rester, mais le bouton par document est plus pratique #}
                    <button
                        class="edl-icon-btn"
                        type="button"
                        data-bs-toggle="modal"
                        data-bs-target="#uploadDocumentModal"
                        title="Ajouter un document"
                    >
                        +
                    </button>
                {% endif %}

                <button class="edl-icon-btn" type="button" data-carousel-prev aria-label="Précédent">←</button>
                <button class="edl-icon-btn" type="button" data-carousel-next aria-label="Suivant">→</button>
            </div>
        </div>

        <div class="edl-scroll" data-carousel>
            {% for doc in documents %}
                <div class="edl-card">
                    <div class="edl-card-media edl-card-media--docs">
                        <div class="edl-media-icon" aria-hidden="true">
                            <svg width="34" height="34" viewBox="0 0 24 24" fill="none" xmlns="http://www.w3.org/2000/svg">
                                <path d="M6 2H14L18 6V20C18 21.1046 17.1046 22 16 22H6C4.89543 22 4 21.1046 4 20V4C4 2.89543 4.89543 2 6 2Z" stroke="white" stroke-width="1.6"/>
                                <path d="M14 2V6H18" stroke="white" stroke-width="1.6"/>
                                <path d="M7 12H15" stroke="white" stroke-width="1.6" stroke-linecap="round"/>
                                <path d="M7 16H13" stroke="white" stroke-width="1.6" stroke-linecap="round"/>
                            </svg>
                        </div>
                    </div>

                    <div class="edl-card-body">
                        <div class="edl-card-title">{{ doc.title }}</div>

                        {% if doc.description %}
                            <div class="edl-card-meta">{{ doc.description }}</div>
                        {% else %}
                            <div class="edl-card-meta">PDF</div>
                        {% endif %}

                        <div class="edl-card-actions d-flex gap-2">
                            {% if doc.pdfName %}
                                {% set pdfSrc = asset('uploads/documents/' ~ doc.pdfName) %}

                                <button
                                    type="button"
                                    class="btn edl-btn edl-btn-secondary flex-fill"
                                    data-bs-toggle="modal"
                                    data-bs-target="#pdfViewerModal"
                                    data-pdf-src="{{ pdfSrc }}"
                                    data-pdf-title="{{ doc.title|e('html_attr') }}"
                                >
                                    Voir
                                </button>

                                {% if is_granted('ROLE_PROFESSEUR') %}
                                    <form method="post" action="{{ path('qcm_generate') }}" class="m-0">
                                        <input type="hidden" name="_csrf_token" value="{{ csrf_token('qcm_generate') }}">
                                        <input type="hidden" name="document_id" value="{{ doc.id }}">
                                        <button type="submit" class="btn edl-btn edl-btn-primary">
                                            Générer QCM
                                        </button>
                                    </form>
                                {% endif %}
                            {% else %}
                                <button class="btn edl-btn edl-btn-secondary flex-fill" disabled>
                                    Indisponible
                                </button>
                            {% endif %}
                        </div>
                    </div>
                </div>
            {% else %}
                <div class="text-muted p-3">
                    Aucun document pour le moment.
                </div>
            {% endfor %}
        </div>
    </div>

    {# ===================== MODAL LECTURE VIDÉO ===================== #}
    <div class="modal fade" id="videoPlayerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-lg">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold" id="videoPlayerTitle">Lecture</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body pt-0">
                    <video id="videoPlayer" class="w-100 rounded" controls playsinline>
                        <source id="videoPlayerSource" src="" type="video/mp4">
                        Votre navigateur ne supporte pas la vidéo.
                    </video>
                </div>
            </div>
        </div>
    </div>

    {# ===================== MODAL LECTURE PDF ===================== #}
    <div class="modal fade" id="pdfViewerModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-dialog-centered modal-xl">
            <div class="modal-content border-0 rounded-4 shadow">
                <div class="modal-header border-0">
                    <h5 class="modal-title fw-bold" id="pdfViewerTitle">Document</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Fermer"></button>
                </div>
                <div class="modal-body pt-0">
                    <iframe
                        id="pdfViewerFrame"
                        title="Lecteur PDF"
                        class="w-100 rounded"
                        style="height: 75vh;"
                        src=""
                    ></iframe>
                    <div class="d-flex justify-content-end mt-3">
                        <a id="pdfViewerDownload" class="btn btn-outline-secondary" href="#" download>
                            Télécharger
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <script>
        document.addEventListener('DOMContentLoaded', () => {
            // ----- Navigation des carrousels (scroll horizontal) -----
            document.querySelectorAll('.edl-section').forEach((section) => {
                const scroller = section.querySelector('[data-carousel]');
                const prevBtn = section.querySelector('[data-carousel-prev]');
                const nextBtn = section.querySelector('[data-carousel-next]');

                if (!scroller || !prevBtn || !nextBtn) return;

                const getStep = () => {
                    // On défile d'une "page" (largeur visible), plus naturel que carte par carte.
                    // On laisse un petit delta pour éviter de s'arrêter entre deux snaps.
                    return Math.max(200, scroller.clientWidth - 20);
                };

                prevBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    scroller.scrollBy({ left: -getStep(), behavior: 'smooth' });
                });

                nextBtn.addEventListener('click', (e) => {
                    e.preventDefault();
                    scroller.scrollBy({ left: getStep(), behavior: 'smooth' });
                });
            });

            // ----- Vidéo -----
            const modalEl = document.getElementById('videoPlayerModal');
            if (modalEl && typeof bootstrap !== 'undefined') {
                const player = document.getElementById('videoPlayer');
                const source = document.getElementById('videoPlayerSource');
                const titleEl = document.getElementById('videoPlayerTitle');

                modalEl.addEventListener('show.bs.modal', (event) => {
                    const trigger = event.relatedTarget;
                    if (!trigger) return;

                    const src = trigger.getAttribute('data-video-src');
                    const title = trigger.getAttribute('data-video-title') || 'Lecture';

                    if (titleEl) titleEl.textContent = title;
                    if (source) source.src = src || '';

                    if (player) {
                        player.load();
                        const p = player.play();
                        if (p && typeof p.catch === 'function') p.catch(() => {});
                    }
                });

                modalEl.addEventListener('hidden.bs.modal', () => {
                    if (player) {
                        player.pause();
                        player.currentTime = 0;
                    }
                    if (source) source.removeAttribute('src');
                    if (player) player.load();
                });
            }

            // ----- PDF -----
            const pdfModalEl = document.getElementById('pdfViewerModal');
            if (pdfModalEl && typeof bootstrap !== 'undefined') {
                const frame = document.getElementById('pdfViewerFrame');
                const titleEl = document.getElementById('pdfViewerTitle');
                const downloadLink = document.getElementById('pdfViewerDownload');

                pdfModalEl.addEventListener('show.bs.modal', (event) => {
                    const trigger = event.relatedTarget;
                    if (!trigger) return;

                    const src = trigger.getAttribute('data-pdf-src');
                    const title = trigger.getAttribute('data-pdf-title') || 'Document';

                    if (titleEl) titleEl.textContent = title;
                    if (frame) frame.src = src || '';
                    if (downloadLink) downloadLink.href = src || '#';
                });

                pdfModalEl.addEventListener('hidden.bs.modal', () => {
                    if (frame) frame.removeAttribute('src');
                    if (downloadLink) downloadLink.href = '#';
                });
            }

            // ----- Upload video: limiter à 1min30 (90s) côté navigateur -----
            const fileInput = document.getElementById('upload_video_file');
            const submitBtn = document.getElementById('uploadVideoSubmitBtn');
            const durationErrorEl = document.getElementById('uploadVideoDurationError');

            const MAX_SECONDS = 90;

            function setDurationError(message) {
                if (!durationErrorEl) return;
                if (message) {
                    durationErrorEl.textContent = message;
                    durationErrorEl.style.display = 'block';
                } else {
                    durationErrorEl.textContent = '';
                    durationErrorEl.style.display = 'none';
                }
            }

            async function checkVideoDuration(file) {
                return new Promise((resolve, reject) => {
                    const url = URL.createObjectURL(file);
                    const video = document.createElement('video');
                    video.preload = 'metadata';
                    video.src = url;

                    const cleanup = () => {
                        URL.revokeObjectURL(url);
                        video.removeAttribute('src');
                    };

                    video.addEventListener('loadedmetadata', () => {
                        const d = Number(video.duration);
                        cleanup();
                        if (!Number.isFinite(d) || d <= 0) {
                            // Certains formats/nav ne donnent pas la durée => on ne bloque pas ici.
                            resolve(null);
                            return;
                        }
                        resolve(d);
                    });

                    video.addEventListener('error', () => {
                        cleanup();
                        resolve(null);
                    });
                });
            }

            if (fileInput && submitBtn) {
                submitBtn.addEventListener('click', async (e) => {
                    setDurationError(null);

                    const file = fileInput.files && fileInput.files[0];
                    if (!file) return;

                    // Vérifie uniquement si le navigateur sait lire la metadata.
                    const duration = await checkVideoDuration(file);
                    if (duration !== null && duration > MAX_SECONDS) {
                        e.preventDefault();
                        setDurationError(`Vidéo trop longue (${Math.round(duration)}s). La durée maximale autorisée est ${MAX_SECONDS}s (1m30).`);
                    }
                });
            }
        });
    </script>

    {# ===================== MODAL UPLOAD VIDÉO ===================== #}
    {% if is_granted('ROLE_PROFESSEUR') %}
        <div class="modal fade" id="uploadVideoModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 rounded-4 shadow">

                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold">➕ Ajouter une vidéo</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body pt-0">
                        {{ form_start(videoForm, {
                            action: path('video_new'),
                            attr: { enctype: 'multipart/form-data' }
                        }) }}

                        <div class="mb-3">
                            {{ form_label(videoForm.title) }}
                            {{ form_widget(videoForm.title, { attr: { class: 'form-control' } }) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(videoForm.description) }}
                            {{ form_widget(videoForm.description, { attr: { class: 'form-control' } }) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(videoForm.videoFile, 'Vidéo (MP4)') }}
                            {{ form_widget(videoForm.videoFile, { attr: { class: 'form-control', id: 'upload_video_file' } }) }}
                            {{ form_errors(videoForm.videoFile) }}
                            <div id="uploadVideoDurationError" class="invalid-feedback d-block" style="display:none"></div>
                            <div class="form-text">Durée max : 1 min 30.</div>
                        </div>

                        <button class="btn btn-primary w-100" id="uploadVideoSubmitBtn">
                            📤 Uploader la vidéo
                        </button>

                        {{ form_end(videoForm) }}
                    </div>

                </div>
            </div>
        </div>
    {% endif %}

    {# ===================== MODAL UPLOAD DOCUMENT ===================== #}
    {% if is_granted('ROLE_PROFESSEUR') %}
        <div class="modal fade" id="uploadDocumentModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered modal-lg">
                <div class="modal-content border-0 rounded-4 shadow">

                    <div class="modal-header border-0">
                        <h5 class="modal-title fw-bold">➕ Ajouter un document</h5>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body pt-0">
                        {{ form_start(documentForm, {
                            action: path('document_new'),
                            attr: { enctype: 'multipart/form-data' }
                        }) }}

                        <div class="mb-3">
                            {{ form_label(documentForm.title, 'Titre') }}
                            {{ form_widget(documentForm.title, { attr: { class: 'form-control' } }) }}
                            {{ form_errors(documentForm.title) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(documentForm.description, 'Description') }}
                            {{ form_widget(documentForm.description, { attr: { class: 'form-control' } }) }}
                            {{ form_errors(documentForm.description) }}
                        </div>

                        <div class="mb-3">
                            {{ form_label(documentForm.pdfFile, 'Document (PDF)') }}
                            {{ form_widget(documentForm.pdfFile, { attr: { class: 'form-control' } }) }}
                            {{ form_errors(documentForm.pdfFile) }}
                        </div>

                        <button class="btn btn-primary w-100">
                            📤 Uploader le document
                        </button>

                        {{ form_end(documentForm) }}
                    </div>

                </div>
            </div>
        </div>
    {% endif %}

    {# ===================== MODAL LOGIN ===================== #}
    {% if not app.user %}
        <div class="modal fade" id="loginModal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <div class="modal-content border-0 rounded-4 shadow">

                    <div class="modal-header border-0">
                        <h4 class="modal-title fw-bold">Connexion Étudiant</h4>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>

                    <div class="modal-body pt-0">
                        <form method="post" action="{{ path('app_login') }}">
                            <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                            <div class="mb-3">
                                <label class="form-label">Email</label>
                                <input type="email" name="_username" class="form-control" required>
                            </div>

                            <div class="mb-3">
                                <label class="form-label">Mot de passe</label>
                                <input type="password" name="_password" class="form-control" required>
                            </div>

                            <button class="btn btn-primary w-100">
                                Se connecter
                            </button>
                        </form>

                        <div class="text-center mt-3">
                            <a href="{{ path('app_register') }}">Créer un compte</a>
                        </div>
                    </div>

                </div>
            </div>
        </div>
    {% endif %}

{% endblock %}
